# Copie este archivo a .env (start.bat lo hace automaticamente) y cambie los secretos.
POSTGRES_USER=autolavado
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=autolavado
TZ=America/Mexico_City

# Genere uno largo y aleatorio (minimo 32 caracteres)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_123456
JWT_EXPIRES_IN=12h

FRONTEND_PORT=3000
BACKEND_PORT=3001
CORS_ORIGIN=*

# Permite crear nuevos negocios (tenants) via POST /api/auth/register-tenant
ALLOW_TENANT_REGISTRATION=false

# Datos demo (negocio "demo"). Ponga SEED_DEMO=false en produccion.
SEED_DEMO=true
SEED_ADMIN_PASSWORD=Admin123!
SEED_WASHER_PASSWORD=Lavador123!

# Superadministrador de plataforma (gestiona todas las empresas). CAMBIE la contrasena.
SUPERADMIN_EMAIL=superadmin@plataforma.local
SUPERADMIN_PASSWORD=cambia_esta_password_superadmin
